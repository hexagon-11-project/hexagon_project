<%@ page pageEncoding="UTF-8"%>

<aside class="sidebar">
	<a class="brand" href="<%=ctx%>/pages/main.jsp"><span
		class="brand-mark">H</span><span>HEXAGON PAY</span></a>
	<div class="nav-group nav-main-group">
		<a class="nav-item <%="main".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/pages/main.jsp"><span class="nav-icon">□</span><span>메인</span></a>
	</div>
	<div class="nav-group">
		<div class="nav-label">기본환경</div>
		<a class="nav-item <%="user-info".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Config/membersInfo.do"><span
			class="nav-icon">□</span><span>사용자 정보</span></a><a
			class="nav-item <%="employee-register1".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Config/employeeIns1.do"><span class="nav-icon">□</span><span>사원
				등록1</span></a><a
			class="nav-item <%="leave-settings".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Config/leavesettingslist.do"><span
			class="nav-icon">□</span><span>휴가/근태 설정</span></a><a
			class="nav-item <%="pay-item-settings".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Config/payitemsetlist.do"><span
			class="nav-icon">□</span><span>給与項目設定</span></a>
	</div>
	<div class="nav-group">
		<div class="nav-label">인사관리</div>
		<a
			class="nav-item <%="employee-list".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Person/employeeMnt.do"><span class="nav-icon">□</span><span>사원현황/관리</span></a><a
			class="nav-item <%="personnel-card".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Person/employeeCard.do"><span
			class="nav-icon">□</span><span>인사기록 카드</span></a><a
			class="nav-item <%="certificate-issue".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Person/certificatePrintWorking.do"><span
			class="nav-icon">□</span><span>제 증명서 발급</span></a><a
			class="nav-item <%="certificate-ledger".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Person/certificateRegister.do"><span
			class="nav-icon">□</span><span>제 증명서 발급 대장</span></a>
	</div>
	<div class="nav-group">
		<div class="nav-label">근태관리</div>
		<a
			class="nav-item <%="attendance-manage".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Diligence/diligenceMnt.do"><span class="nav-icon">□</span><span>근태기록/관리</span></a><a
			class="nav-item <%="attendance-search".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Diligence/diligenceSearchMonth.do"><span
			class="nav-icon">□</span><span>근태조회</span></a><a
			class="nav-item <%="leave-search".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Diligence/holidaysSearchResult.do"><span
			class="nav-icon">□</span><span>휴가조회</span></a><a
			class="nav-item <%="daily-work-manage".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Diligence/dayWorkerMnt.do"><span class="nav-icon">□</span><span>일용직
				근무기록/관리</span></a><a
			class="nav-item <%="daily-work-search".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Diligence/dayWorkerSearchMonth.do"><span
			class="nav-icon">□</span><span>일용직 근무 조회</span></a>
	</div>
	<div class="nav-group">
		<div class="nav-label">급여관리</div>
		<a
			class="nav-item <%="payroll-manage".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Payment/paymentMnt.do"><span
			class="nav-icon">□</span><span>급여입력/관리</span></a><a
