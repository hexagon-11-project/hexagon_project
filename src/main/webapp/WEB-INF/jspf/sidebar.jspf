<%@ page pageEncoding="UTF-8"%>

<aside class="sidebar">
	<a class="brand" href="<%=ctx%>/pages/main.jsp"><span
		class="brand-mark">H</span><span>HEXAGON PAY</span></a>
	<div class="nav-group nav-main-group">
		<a class="nav-item <%="main".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/pages/main.jsp"><span class="nav-icon">□</span><span>메인</span></a>
	</div>
	<div class="nav-group">
		<div class="nav-label">基本設定</div>
		<a class="nav-item <%="user-info".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Config/membersInfo.do"><span
			class="nav-icon">□</span><span>ユーザー情報</span></a><a
			class="nav-item <%="employee-register1".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Config/employeeIns1.do"><span class="nav-icon">□</span><span>사원
				등록1</span></a><a
			class="nav-item <%="leave-settings".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Config/leavesettingslist.do"><span
			class="nav-icon">□</span><span>휴가/근태 설정</span></a><a
			class="nav-item <%="pay-item-settings".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Config/payitemsetlist.do"><span
			class="nav-icon">□</span><span>給与項目設定</span></a>
	</div>
	<div class="nav-group">
		<div class="nav-label">人事管理</div>
		<a
			class="nav-item <%="employee-list".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Person/employeeMnt.do"><span class="nav-icon">□</span><span>社員現況/管理</span></a><a
			class="nav-item <%="personnel-card".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Person/employeeCard.do"><span
			class="nav-icon">□</span><span>人事記録カード</span></a><a
			class="nav-item <%="certificate-issue".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Person/certificatePrintWorking.do"><span
			class="nav-icon">□</span><span>諸証明書発行</span></a><a
			class="nav-item <%="certificate-ledger".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Person/certificateRegister.do"><span
			class="nav-icon">□</span><span>諸証明書発行台帳</span></a>
	</div>
	<div class="nav-group">
		<div class="nav-label">근태관리</div>
		<a
			class="nav-item <%="attendance-manage".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Diligence/diligenceMnt.do"><span class="nav-icon">□</span><span>근태기록/관리</span></a><a
			class="nav-item <%="attendance-search".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Diligence/diligenceSearchMonth.do"><span
			class="nav-icon">□</span><span>근태조회</span></a><a
			class="nav-item <%="leave-search".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Diligence/holidaysSearchResult.do"><span
			class="nav-icon">□</span><span>휴가조회</span></a><a
			class="nav-item <%="daily-work-manage".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Diligence/dayWorkerMnt.do"><span class="nav-icon">□</span><span>일용직
				근무기록/관리</span></a><a
			class="nav-item <%="daily-work-search".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Diligence/dayWorkerSearchMonth.do"><span
			class="nav-icon">□</span><span>일용직 근무 조회</span></a>
	</div>
	<div class="nav-group">
		<div class="nav-label">급여관리</div>
		<a
			class="nav-item <%="payroll-manage".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Payment/paymentMnt.do"><span
			class="nav-icon">□</span><span>給与入力・管理</span></a><a
			class="nav-item <%="daily-payroll".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Payment/paymentMntDayWorker.do"><span
			class="nav-icon">□</span><span>給与入力・管理（日雇い）</span></a><a
			class="nav-item <%="payroll-ledger".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Payment/paymentRegisterList.do"><span
			class="nav-icon">□</span><span>給与台帳</span></a><a
			class="nav-item <%="pay-slip".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Payment/paymentPayslip.do"><span class="nav-icon">□</span><span>給与明細</span></a><a
			class="nav-item <%="employee-pay-history".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Payment/paymentPayList.do"><span
			class="nav-icon">□</span><span>社員別給与内訳</span></a><a
			class="nav-item <%="transfer-request".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Payment/paymenttransfer.do"><span
			class="nav-icon">□</span><span>給与振込申請</span></a><a
			class="nav-item <%="transfer-result".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Payment/paymenttransferlist.do"><span
			class="nav-icon">□</span><span>給与振込結果照会</span></a><a
			class="nav-item <%="item-ledger".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Payment/paymentPayItemPart.do"><span
			class="nav-icon">□</span><span>項目別台帳</span></a><a
			class="nav-item <%="insurance-deduction".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Payment/fourinsureList.do"><span
			class="nav-icon">□</span><span>4大保険控除内訳</span></a>
	</div>
	<div class="nav-group">
		<div class="nav-label">급여통계</div>
		<a
			class="nav-item <%="annual-personal".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Statistics/paymentStatistics.do"><span
			class="nav-icon">□</span><span>年度別個人年俸統計</span></a><a
			class="nav-item <%="monthly-personal".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Statistics/paymentStatisticsMonth.do"><span
			class="nav-icon">□</span><span>月別個人給与統計</span></a><a
			class="nav-item <%="paymentstatisticsall".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Statistics/paymentStatisticsAll.do"><span
			class="nav-icon">□</span><span>年度別給与総額統計</span></a><a
			class="nav-item <%="monthly-total".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Statistics/paymentStatisticsAllMonth.do"><span
			class="nav-icon">□</span><span>月別給与総額統計</span></a><a
			class="nav-item <%="item-composition".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Statistics/paymentStatisticsPayItems.do"><span
			class="nav-icon">□</span><span>給与項目構成統計</span></a>
	</div>
	<div class="nav-group">
		<div class="nav-label">退職管理</div>
		<a
			class="nav-item <%="retirement-process".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Retire/retireProcess.do"><span
			class="nav-icon">□</span><span>社員退職処理</span></a><a
			class="nav-item <%="retirement-pay".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Retire/retirementMnt.do"><span
			class="nav-icon">□</span><span>退職給与入力/管理</span></a><a
			class="nav-item <%="retirement-slip".equals(activeKey) ? "active" : ""%>"
			href="<%=ctx%>/Retire/retirePayslip.do"><span
			class="nav-icon">□</span><span>退職給与明細書</span></a>
	</div>
</aside>
